{
  "name": "novel-companion",
  "version": "0.2.0",
  "private": true,
  "license": "Apache-2.0",
  "scripts": {
    "dev": "pnpm --filter @novel/web dev",
    "dev:all": "pnpm -r --parallel --filter @novel/web --filter @novel/server --filter @novel/agents run dev",
    "dev:agents": "pnpm --filter @novel/agents dev",
    "dev:server": "pnpm --filter @novel/server dev",
    "build": "pnpm --filter @novel/web build",
    "build:server": "pnpm --filter @novel/server build",
    "start:server": "pnpm --filter @novel/server start",
    "lint": "pnpm -r lint",
    "lint:server": "pnpm --filter @novel/server lint",
    "type-check": "pnpm -r type-check",
    "type-check:server": "pnpm --filter @novel/server type-check",
    "verify:memory": "node scripts/tools/memory-sample-check.mjs",
    "verify:all": "node scripts/verify/verify-all.mjs",
    "verify:modes": "node scripts/verify/verify-plugin-mode-separation.mjs",
    "e2e:modes": "node scripts/e2e/e2e-mode-separation.mjs",
    "e2e:ui": "node scripts/e2e/e2e-ui-integration.mjs",
    "verify:spacing": "node scripts/tools/spacing-audit.mjs ."
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.8.0+sha512.c1f5e7c4cb241c8f174b743851d82f42b802324afc8b0f116b96adb15aa06664948dde36960a3ba1079ba5b4b29dd0140135b94b5b5f5263592249d68e555f26",
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-host-webserver": "0.1.1-rc.2",
    "@deepseek-ai/dsh-invariants": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "devDependencies": {
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@radix-ui/react-visually-hidden": "^1.2.13",
    "class-variance-authority": "~0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "tailwind-merge": "^2.6.1",
    "tailwindcss-animate": "^1.0.7"
  }
}
