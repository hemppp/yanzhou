{
  "name": "@novel-plugins/ui-kit",
  "version": "0.1.0",
  "private": true,
  "description": "共享 UI 原子：错误边界 / Toast / 返回键 / 抽屉侧栏 / GSAP 动效 / AI 原语（无业务状态）",
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./primitives": {
      "types": "./src/primitives/index.ts",
      "import": "./src/primitives/index.ts",
      "default": "./src/primitives/index.ts"
    },
    "./errors": {
      "types": "./src/errors.ts",
      "import": "./src/errors.ts",
      "default": "./src/errors.ts"
    },
    "./gsap": {
      "types": "./src/gsap.ts",
      "import": "./src/gsap.ts",
      "default": "./src/gsap.ts"
    },
    "./safeConfirm": {
      "types": "./src/safeConfirm.ts",
      "import": "./src/safeConfirm.ts",
      "default": "./src/safeConfirm.ts"
    },
    "./themeStore": {
      "types": "./src/themeStore.ts",
      "import": "./src/themeStore.ts",
      "default": "./src/themeStore.ts"
    },
    "./styles/identity.css": "./src/styles/identity.css",
    "./styles/vscode-dark-modern.css": "./src/styles/vscode-dark-modern.css",
    "./useGlassRipple": {
      "types": "./src/useGlassRipple.ts",
      "import": "./src/useGlassRipple.ts",
      "default": "./src/useGlassRipple.ts"
    },
    "./aiBars": {
      "types": "./src/aiBars.tsx",
      "import": "./src/aiBars.tsx",
      "default": "./src/aiBars.tsx"
    }
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "gsap": "^3.15.0",
    "lucide-react": "^0.468.0",
    "zustand": "^5.0.0"
  }
}
