{
  "name": "@novel/desktop",
  "version": "1.1.0",
  "private": true,
  "description": "砚舟 桌面端（Electron 主进程 + 内嵌 server 子进程）",
  "author": "砚舟",
  "license": "Apache-2.0",
  "main": "dist/main.cjs",
  "scripts": {
    "icon": "python scripts/gen-icon.py",
    "payload": "node scripts/build-server-payload.mjs",
    "bundle": "node scripts/bundle-shell.mjs",
    "dev": "node scripts/bundle-shell.mjs && electron .",
    "build": "node scripts/build-server-payload.mjs && node scripts/bundle-shell.mjs",
    "type-check": "tsc --noEmit",
    "dist:dir": "node scripts/build-server-payload.mjs && node scripts/bundle-shell.mjs && node scripts/native-abi.mjs stage && electron-builder --win dir --x64 && node scripts/native-abi.mjs verify",
    "dist": "node scripts/build-server-payload.mjs && node scripts/bundle-shell.mjs && node scripts/native-abi.mjs stage && electron-builder --win nsis --x64 && node scripts/native-abi.mjs verify",
    "dist:zip": "node scripts/build-server-payload.mjs && node scripts/bundle-shell.mjs && node scripts/native-abi.mjs stage && electron-builder --win --x64 --dir && node scripts/native-abi.mjs verify && node scripts/package-portable-zip.mjs",
    "dist:local": "node scripts/dist-local.mjs dist"
  },
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "yauzl": "^3.4.0"
  },
  "devDependencies": {
    "adm-zip": "^0.5.16",
    "electron": "44.5.1",
    "electron-builder": "26.15.3",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.0"
  },
  "build": {
    "appId": "com.novelmuse.desktop",
    "publish": null,
    "productName": "砚舟",
    "copyright": "Copyright © 2026 砚舟",
    "directories": {
      "output": "../../release/desktop",
      "buildResources": "build-resources"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "node_modules/bindings/**/*",
      "node_modules/file-uri-to-path/**/*"
    ],
    "extraResources": [
      { "from": "payload/app-server", "to": "app-server" },
      { "from": "payload/app-server/node_modules", "to": "app-server/node_modules" },
      { "from": "../../apps/web/dist", "to": "web-dist" },
      { "from": "payload/seed-plugins", "to": "seed-plugins" }
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "build-resources/icon.ico",
      "artifactName": "砚舟-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "砚舟",
      "artifactName": "砚舟-Setup-${version}-${arch}.${ext}",
      "deleteAppDataOnUninstall": false
    }
  }
}
