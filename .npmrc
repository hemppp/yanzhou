# ============================================================
# .npmrc —— pnpm 行为约定
#
# confirmModulesPurge=false
#   启停 dev server（如 Claude 的 preview_start）时，pnpm 会先跑一次
#   `runDepsStatusCheck`，一旦判定 node_modules 与 lockfile "可能不一致"
#   就想清空重装；**无 TTY 环境**下它会拒绝并报
#   `ERR_PNPM_ABORTED_REMOVE_MODULES_DIR_NO_TTY`，导致服务起不来。
#   而在无头/托管环境里没人能回答那个确认提示 ⇒ 显式关掉确认。
#   注意：这只关掉"要不要清空"的**询问**，不会改变安装结果；
#   依赖真不一致时它仍会正常重装（只是不再问）。
# ============================================================
confirmModulesPurge=false
