# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
# ★ 2026-09-17 补：构建前 `mv dist dist.old` 是绕 safe-delete 守卫的常规操作，
#   而 `dist/` 这条匹配不到 `dist.old/` —— 一次 `git add -A` 就把整个旧产物收进仓库了
#   （当天真的发生过，70 个文件）。所以显式加上。
dist.old/
dist.bak*/
build/
.next/
.vite/

# Database files (IMPORTANT: 防止数据丢失)
*.db
*.db-journal
*.db-wal
*.db-shm
data/*.db
data/*.bak
data/*.db.bak*
# data/ 全部是运行时产物（SQLite、用户稿件 projects/、账号备份），一律不入库
/data/
# 整库备份目录与发布产物
data-backup-*/
/release/

# 开发环境持久化的 JWT 签名密钥（敏感，严禁提交）
data/.jwt-secret
.jwt-secret

