# ============================================================
# NovelMuse 环境变量配置
# 复制此文件为 .env 并填入实际值
# ============================================================

# ---- 服务端配置 ----
PORT=3774
NODE_ENV=development

# ---- JWT 配置 ----
# 生产环境必填：缺失时服务端拒绝启动。生成：openssl rand -hex 32
# 开发环境未设置时自动生成并持久化到 data/.jwt-secret（重启不掉线）
JWT_SECRET=your-super-secret-key-change-this
JWT_EXPIRES_IN=30d

# ---- 会话 Cookie 配置（C4）----
# 认证 JWT 经 HttpOnly + SameSite=Strict Cookie 下发，前端 JS 不可读。
# 仅 HTTPS 部署时设为 true（本机/内网 http 下开启会导致 Cookie 不发送、登录失效）
COOKIE_SECURE=false

# ---- 注册开关（C10）----
# 未设置时：生产环境（NODE_ENV=production）默认关闭，开发环境默认开启。
# 显式设置 true/false 可强制开启/关闭。容器部署请保持关闭（默认 0.0.0.0 暴露）
ALLOW_REGISTRATION=false

# ---- SSRF 出站防护（C8）----
# AI baseUrl 指向私网/链路本地/保留地址时默认拦截（防内网探测/元数据窃取）。
# 本地 Ollama（127.0.0.1）默认放行；LAN 内自建中转站需放开私网时设为 true
AI_SSRF_ALLOW_PRIVATE=false
# 完全关闭 SSRF 守卫（不推荐）
# AI_SSRF_DISABLE=0

# ---- 管理员配置 ----
# 引导账号用户名，仅在系统内还没有任何管理员时生效（默认 admin）
ADMIN_USERNAME=
# 首次启动时自动创建管理员账户；未设置则随机生成强密码并打印到控制台（仅显示一次）
# 已存在管理员时设置此项，会在每次启动同步该管理员的密码（覆盖界面上的修改）
ADMIN_PASSWORD=

# ---- 数据库配置 ----
# 引擎：better-sqlite3（推荐，原生性能）或 sqljs（WASM，无需编译）
NOVELMUSE_DB_ENGINE=better-sqlite3

# ---- AI 配置（环境变量方式，也可在应用内 UI 配置）----
AI_PROVIDER=openai

# OpenAI
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo

# Ollama（本地部署）
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# Custom（自定义 OpenAI 兼容 API）
CUSTOM_AI_BASE_URL=
CUSTOM_AI_API_KEY=
CUSTOM_AI_MODEL=

# ---- 代理配置（中国大陆访问 OpenAI 等服务需要）----
# 留空则自动探测本机代理（Clash/V2Ray 等）
HTTPS_PROXY=

# ---- 前端配置 ----
# ⚠️ 必须带 /api 后缀：前端以它为 API 根，相对路径（/auth/login 等）直接拼在其后。
# 漏写 /api 会让请求打到 http://localhost:3774/auth/login → 全部 API 404 / CORS 失败。
VITE_API_BASE_URL=http://localhost:3774/api
