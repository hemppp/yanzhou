# ============================================================
# NovelMuse Docker 部署环境变量示例
#
# 使用方式：
#   cp .env.docker.example .env
#   按需修改后执行 docker compose up -d --build
#
# 说明：
#   - 所有 AI 相关配置也可在应用内「设置 → AI 配置」中修改（按用户存储）
#   - 此处的环境变量作为全局默认值，应用内配置优先级更高
#   - 敏感信息（API Key、JWT Secret）建议仅放在 .env 文件中，不入库
# ============================================================

# ---- 服务端口（宿主机映射端口，容器内固定 3774）----
PORT=3774

# ---- 安全配置 ----
# 管理员引导账号用户名（仅在系统内还没有任何管理员时生效，默认 admin）
ADMIN_USERNAME=
# 管理员密码：不设置则首次启动自动生成并打印到日志（查看：docker compose logs novelmuse）
ADMIN_PASSWORD=
# JWT 密钥：不设置则服务端自动生成（重启后需重新登录）；生产环境建议固定
JWT_SECRET=
# JWT 过期时间（活跃期间由前端滑动续期，此值≈「停止使用后多久退出登录」）
JWT_EXPIRES_IN=30d

# ---- AI 配置 ----
# 提供商：openai | ollama | custom
AI_PROVIDER=openai

# OpenAI
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4-turbo

# Ollama（本地部署，容器通过 host.docker.internal 访问宿主机服务）
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=qwen2.5:7b

# Custom（自定义 OpenAI 兼容 API / 中转站）
CUSTOM_AI_BASE_URL=
CUSTOM_AI_API_KEY=
CUSTOM_AI_MODEL=

# ---- 代理配置 ----
# 容器内访问外网需要（如 OpenAI）；留空则直连
# 格式：http://proxy-host:port 或 http://user:pass@proxy-host:port
HTTPS_PROXY=

# ---- Python Agents（可选，需 --profile agents 启动）----
# Strands Agents SDK 使用的 AI 配置（默认复用上方 OpenAI 配置）
AGENTS_OPENAI_API_KEY=
AGENTS_OPENAI_BASE_URL=
